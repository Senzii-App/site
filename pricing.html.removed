<div class="checkout-modal" id="checkout-modal" style="display:none !important;">
      <div class="checkout-modal-inner">
        <button class="checkout-modal-close" id="checkout-close" aria-label="Close">&#x2715;</button>
        <h2 class="checkout-title">Set up your account</h2>
        <p class="checkout-subtitle" id="checkout-plan-label">Senzii — $5/staff member/month</p>
        <form id="checkout-form">
          <div class="form-group">
            <label for="checkout-seats">How many staff members do you need?</label>
            <input type="number" id="checkout-seats" name="seats" min="1" value="15" required style="width:100%;padding:0.625rem 0.75rem;border-radius:0.375rem;border:1px solid var(--border);background:var(--surface);color:var(--text);font-size:0.95rem;">
            <p style="font-size:0.78rem;color:var(--text-muted);margin-top:0.3rem;">$5.00 per staff member per month · 1 month free trial</p>
            <p style="font-size:0.88rem;color:var(--text);margin-top:0.4rem;font-weight:600;" id="checkout-total-label">15 staff × $5/mo = $75/mo</p>
          </div>
          <div class="form-group">
            <label for="checkout-name">Full name</label>
            <input type="text" id="checkout-name" name="name" placeholder="Jordan Smith" required>
          </div>
          <div class="form-group">
            <label for="checkout-email">Work email</label>
            <input type="email" id="checkout-email" name="email" placeholder="admin@yourcompany.com" required>
          </div>
          <div class="form-group">
            <label for="checkout-phone">Phone number</label>
            <input type="tel" id="checkout-phone" name="phone" placeholder="(215) 555-0100" required>
          </div>
          <div class="form-group">
            <label for="checkout-org">Organization name</label>
            <input type="text" id="checkout-org" name="orgName" placeholder="Acme Staffing" required>
          </div>
          <button type="submit" class="btn-checkout" id="checkout-submit">
            <span id="checkout-btn-text">Continue to payment</span>
          </button>
        </form>
        <div id="checkout-error" class="auth-error" style="display:none;"></div>
      </div>
    </div>
  </div>
</section>

<section class="workflow">
  <div class="section-inner">
<script>
<script>
(function() {
  var modal = document.getElementById('checkout-modal');
  var form = document.getElementById('checkout-form');
  var closeBtn = document.getElementById('checkout-close');
  var errorDiv = document.getElementById('checkout-error');
  var submitBtn = document.getElementById('checkout-submit');
  var btnText = document.getElementById('checkout-btn-text');
  var planLabel = document.getElementById('checkout-plan-label');
  var seatsInput = document.getElementById('checkout-seats');
  var totalLabel = document.getElementById('checkout-total-label');

  // Live total calculation
  function updateTotal() {
    var seats = parseInt(seatsInput.value) || 1;
    if (seats < 1) seats = 1;
    var total = (seats * 5).toFixed(0);
    totalLabel.textContent = seats + ' staff × $5/mo = $' + total + '/mo';
  }
  seatsInput.addEventListener('input', updateTotal);
  updateTotal();

  document.querySelectorAll('.js-checkout').forEach(function(btn) {
    btn.addEventListener('click', function() {
      planLabel.textContent = btn.dataset.planLabel || 'Senzii — $5/staff member/month';
      errorDiv.style.display = 'none';
      modal.style.display = 'flex';
      document.getElementById('checkout-email').focus();
    });
  });

  closeBtn.addEventListener('click', function() { modal.style.display = 'none'; });
  modal.addEventListener('click', function(e) { if (e.target === modal) modal.style.display = 'none'; });

  form.addEventListener('submit', async function(e) {
    e.preventDefault();
    errorDiv.style.display = 'none';
    submitBtn.disabled = true;
    btnText.textContent = 'Redirecting to payment…';

    var seats = parseInt(seatsInput.value) || 1;
    var name = document.getElementById('checkout-name').value;
    var email = document.getElementById('checkout-email').value;
    var phone = document.getElementById('checkout-phone').value;
    var orgName = document.getElementById('checkout-org').value;

    try {
      var res = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orgName: orgName, email: email, seats: seats, name: name, phone: phone })
      });
      var data = await res.json();

      if (res.status === 503 && (data.reason === 'stripe_unconfigured' || data.reason === 'stripe_price_not_configured')) {
        var modalInner = modal.querySelector('.checkout-modal-inner');
        modalInner.innerHTML = [
          '<button class="checkout-modal-close" id="checkout-close-new" aria-label="Close">&#x2715;</button>',
          '<h2 class="checkout-title" style="margin-bottom:0.5rem;">Coming Soon</h2>',
          '<p style="color:var(--text-muted);font-size:0.88rem;margin-top:0.75rem;">',
            'Sign up will be available shortly. We will notify you at <strong>' + email + '</strong> when it is ready.',
          '</p>',
          '<button class="btn-checkout" style="margin-top:1.5rem;" id="checkout-close-btn">Close</button>',
        ].join('');
        document.getElementById('checkout-close-new').addEventListener('click', function() { modal.style.display = 'none'; });
        document.getElementById('checkout-close-btn').addEventListener('click', function() { modal.style.display = 'none'; });
        return;
      }

      if (!res.ok) throw new Error(data.error || 'Checkout failed');
      window.location.href = data.url;
    } catch(err) {
      errorDiv.textContent = err.message;
      errorDiv.style.display = 'block';
      submitBtn.disabled = false;
      btnText.textContent = 'Continue to payment';
    }
  });
})();
</script>
</script>
  <div style="padding:1.75rem;background:var(--accent-dim);border-radius:12px;margin:0 1.5rem 2rem;">
    <h3 style="margin:0 0 0.75rem;font-size:1.15rem;color:var(--text);">Free tools to help you schedule smarter</h3>
    <p style="font-size:0.9rem;color:var(--text-muted);margin-bottom:1.25rem;">Try these free calculators and tools — no signup required to start.</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:0.75rem;">
      <a href="/scheduling-maturity-assessment" style="display:block;padding:1rem 1.25rem;background:var(--surface);border:1px solid var(--border);border-radius:8px;text-decoration:none;color:var(--text);"><strong style="display:block;font-size:0.95rem;color:var(--accent);margin-bottom:0.25rem;">Scheduling Maturity Assessment →</strong><span style="font-size:0.82rem;color:var(--text-muted);">Score your scheduling across 5 dimensions</span></a>
      <a href="/cost-calculator" style="display:block;padding:1rem 1.25rem;background:var(--surface);border:1px solid var(--border);border-radius:8px;text-decoration:none;color:var(--text);"><strong style="display:block;font-size:0.95rem;color:var(--accent);margin-bottom:0.25rem;">Cost Calculator →</strong><span style="font-size:0.82rem;color:var(--text-muted);">See how much bad scheduling costs you</span></a>
