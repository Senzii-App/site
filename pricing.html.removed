    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/theme.css">
    <title>Pricing | Senzii Scheduling Software</title>
    <meta name="description" content="Simple, transparent pricing for Senzii scheduling software. $5 per staff member per month. Free 14-day trial. No credit card required. Cancel anytime.">
    <link rel="canonical" href="https://senzii.com/pricing">
    <meta property="og:title" content="Pricing | Senzii Scheduling Software">
    <meta property="og:description" content="AI-powered scheduling for $5 per staff member per month. Start free, scale as you grow. No hidden fees.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://senzii.com/pricing">
    <meta name="twitter:card" content="summary_large_image">
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Senzii Scheduling Software",
  "description": "AI-powered staff scheduling software for businesses of all sizes. $5 per staff member per month.",
  "brand": {
    "@type": "Brand",
    "name": "Senzii"
  },
  "offers": {
    "@type": "Offer",
    "price": "5.00",
    "priceCurrency": "USD",
    "description": "$5 per staff member per month with 14-day free trial. No credit card required."
  }
}
    </script>
    <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do I need a credit card to start the free trial?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. You can start a 14-day free trial without entering any payment information. We'll remind you before the trial ends, and you can add a payment method whenever you're ready."
      }
    },
    {
      "@type": "Question",
      "name": "How does pricing work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Senzii costs $5 per staff member per month. You only pay for the staff you actually schedule. There are no tier limits, no hidden fees, and no annual contracts. A team of 15 staff costs $75/month."
      }
    },
    {
      "@type": "Question",
      "name": "Can I cancel anytime?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. There are no contracts or cancellation fees. Cancel from your account settings at any time, and you won't be billed for the next cycle. You keep access until the end of your current billing period."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer discounts for nonprofits or educational institutions?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Registered nonprofits and educational institutions receive a 20% discount. Contact our support team with your tax-exempt documentation to apply."
      }
    },
    {
      "@type": "Question",
      "name": "What integrations are available?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Senzii integrates with Slack, Microsoft Teams, QuickBooks, ADP, Google Calendar, and Zapier. See our integrations page for details."
      }
    },
    {
      "@type": "Question",
      "name": "Is my data secure?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "All data is encrypted in transit (TLS 1.3) and at rest (AES-256). We are GDPR compliant and undergo regular security audits. Enterprise plans include SSO, audit logs, and advanced permission controls."
      }
    }
  ]
}
    </script>
</head>
